# ==============================================================================
# Environment Configuration Template
# Secure Real-Time Remote Code Execution Laboratory Platform
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Secure Remote Code Execution Lab"
API_V1_STR="/api/v1"

# API Gateway Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=dev_secret_password
POSTGRES_DB=remote_lab_db
DATABASE_URL=postgresql+asyncpg://lab_admin:dev_secret_password@localhost:5432/remote_lab_db

# Redis Broker & Pub/Sub Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT)
SECRET_KEY=super_secret_dev_key_must_be_at_least_32_bytes_long_for_hs256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Execution Sandbox Limits & Defaults
SANDBOX_IMAGE_PYTHON=lab-sandbox-python:3.11
EXECUTION_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_QUOTA=50000
SANDBOX_MAX_PIDS=64
SANDBOX_MAX_OUTPUT_BYTES=1048576
