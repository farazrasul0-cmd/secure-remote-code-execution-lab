# ==============================================================================
# Production Environment Variable Configuration Template
# Platform: Secure Real-Time Remote Code Execution Laboratory Platform
# ==============================================================================

# General Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Secure Remote Code Execution Lab"

# Host & Network Ingress
HOST_DOMAIN=localhost
CORS_ORIGINS=http://localhost,https://rcelab.university.edu

# Database (PostgreSQL 16)
POSTGRES_USER=rcelab_admin
POSTGRES_PASSWORD=generate_a_cryptographically_secure_password_here_min_32_chars
POSTGRES_DB=rcelab_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Message Broker & Cache (Redis 7)
REDIS_URL=redis://redis:6379/0

# Security & Cryptography
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_minimum_64_character_cryptographically_random_token
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Distributed Rate Limiting (Sliding Window Log via Redis ZSET)
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=15
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Celery Execution Engine Concurrency
CELERY_CONCURRENCY=4
